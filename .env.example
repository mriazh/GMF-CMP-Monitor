# GMF CMP Monitor - example configuration
#
# Copy this file OUTSIDE the repository (e.g. to ~/.config/gmf-cmp-monitor.env)
# or rename it to .env in your local workspace. Never commit real credentials.
# This file only contains placeholders and non-secret defaults.

# CMP portal URLs must be HTTPS on host ep.iotcc.telkomsel.com
CMP_CAS_URL=https://ep.iotcc.telkomsel.com/cas/login?service=https%3A%2F%2Fep.iotcc.telkomsel.com%2Fcas%2Foauth2.0%2FcallbackAuthorize%3Fclient_id%3DenterprisePortal%26redirect_uri%3Dhttps%253A%252F%252Fep.iotcc.telkomsel.com%26response_type%3Dcode%26client_name%3DCasOAuthClient
CMP_PRODUCTS_URL=https://ep.iotcc.telkomsel.com/#!products
CMP_DASHBOARD_URL=https://ep.iotcc.telkomsel.com/#!dashboard

# CMP credentials are placeholders only and never real values here
CMP_USERNAME=your_cmp_username
CMP_PASSWORD=your_cmp_password

# IMAP Configuration
IMAP_HOST=mail.company.local
IMAP_PORT=993
IMAP_USERNAME=your_imap_username
IMAP_PASSWORD=your_imap_password
# IMAP TLS mode is imaps or starttls
IMAP_TLS_MODE=imaps
# Set to false for internal mail servers with enterprise self-signed certificates
IMAP_VERIFY_TLS=false
IMAP_MAILBOX=INBOX

# OTP Settings
# OTP subject must exactly match the enforced subject
OTP_SUBJECT=CMP - YOUR TOKEN
OTP_POLL_INTERVAL_SECONDS=2
# Timeout for waiting OTP email (180s recommended during peak Telkomsel SMS/email gateway hours)
OTP_TIMEOUT_SECONDS=180
OTP_CLOCK_SKEW_TOLERANCE_SECONDS=120

# Runtime & Browser Settings
RUN_START_TIMEZONE=Asia/Jakarta
BROWSER_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=90000
OTP_FORM_TIMEOUT_MS=60000
REFRESH_INTERVAL_SECONDS=60
RECOVERY_RETRY_LIMIT=3
RECOVERY_BACKOFF_SECONDS=5
# Runtime is headed by default; set HEADLESS=true for headless operation.
HEADLESS=false
# Set VIEWPORT_AUTO=true to auto-fit laptop screens (1366x768, etc.) without right-side clipping
VIEWPORT_AUTO=true
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
# Page zoom percentage (default 67% scales the Vaadin 7 dashboard to fit comfortably on laptops and office displays)
PAGE_ZOOM_PERCENT=67
# Optional: use the installed Firefox executable instead of Playwright's bundled browser.
# FIREFOX_EXECUTABLE_PATH="C:/Program Files/Mozilla Firefox/firefox.exe"

# Logging
LOG_LEVEL=INFO

# VPN automation settings (Check Point / WARP fallback integration)
# VPN fallback strategy: none (disabled), warp (Cloudflare WARP), checkpoint (Check Point VPN)
VPN_TYPE=none
VPN_RECONNECT_MAX_RETRIES=3
VPN_RECONNECT_COOLDOWN_SECONDS=60
VPN_COMMAND_TIMEOUT_SECONDS=30

# Check Point adapter uses: trac info -s, trac connect -s, trac disconnect.
# credentials mode passes CHECKPOINT_USERNAME/CHECKPOINT_PASSWORD to trac.exe
# for unattended authentication; local process-inspection exposure is accepted
# for this approved workflow. Never print these values to logs or reports.
CHECKPOINT_TRAC_PATH="C:/Program Files (x86)/CheckPoint/Endpoint Connect/trac.exe"
CHECKPOINT_SITE=VPN-CORP
CHECKPOINT_GATEWAY_NAME=CORP-GW01
CHECKPOINT_GATEWAY_IP=203.0.113.1
CHECKPOINT_USERNAME=your_checkpoint_username
CHECKPOINT_PASSWORD=your_checkpoint_password
CHECKPOINT_AUTH_MODE=credentials
CHECKPOINT_ALLOW_INTERACTIVE=false

# Cloudflare WARP operates in isolated SOCKS5 proxy mode ('proxy') or full-tunnel ('warp').
# 'proxy' mode is recommended: runs on 127.0.0.1:40000, isolates traffic to browser only,
# leaves host OS network & IMAP untouched, and never needs disconnect/reconnect on re-authentication.
# Registration IDs and licenses stay out of env. Status is queried using the warp-cli status subcommand.
# Optional Zero Trust organization name placeholder:
# WARP_ORGANIZATION=your_org
WARP_CLI_PATH="C:/Program Files/Cloudflare/Cloudflare WARP/warp-cli.exe"
WARP_VARIANT=consumer
WARP_MODE=proxy
WARP_PROXY_PORT=40000
WARP_ALLOW_DNS_ONLY=false
WARP_REUSE_EXISTING=true
WARP_DISCONNECT_ON_EXIT=true
WARP_TRACE_URL=https://www.cloudflare.com/cdn-cgi/trace

# Office network reachability probes:
# Primary probe tests IMAP DNS/TCP/TLS; secondary URL probe is optional.
OFFICE_NETWORK_PROBE_HOST=mail.company.local
OFFICE_NETWORK_PROBE_PORT=993
OFFICE_NETWORK_PROBE_SECONDARY_URL=https://portal.company.local/
OFFICE_NETWORK_PROBE_TIMEOUT_SECONDS=10

# Timing values are bounded polling/retry controls:
CHECKPOINT_CONNECT_TIMEOUT_SECONDS=60
CHECKPOINT_STATUS_POLL_INTERVAL_SECONDS=2
CHECKPOINT_RETRY_LIMIT=3
CHECKPOINT_DISCONNECT_TIMEOUT_SECONDS=30
WARP_CONNECT_TIMEOUT_SECONDS=60
WARP_STATUS_POLL_INTERVAL_SECONDS=2
WARP_RETRY_LIMIT=3
WARP_TRACE_TIMEOUT_SECONDS=15
DASHBOARD_RETRY_LIMIT=3
AUTH_CYCLE_RETRY_LIMIT=3

# Opt-in live lifecycle test only
# ENABLE_LIVE_LIFECYCLE=true
# BOUNDED_DASHBOARD_CYCLES=1
