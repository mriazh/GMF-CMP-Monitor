# GMF CMP Monitor - example configuration
#
# Copy this file OUTSIDE the repository (e.g. to ~/.config/gmf-cmp-monitor.env)
# and fill in real values there. Never commit real credentials.
# This file only contains placeholders and non-secret defaults.

# CMP portal URLs must be HTTPS on host ep.iotcc.telkomsel.com
CMP_CAS_URL=https://ep.iotcc.telkomsel.com/cas/login
CMP_PRODUCTS_URL=https://ep.iotcc.telkomsel.com/#!products
CMP_DASHBOARD_URL=https://ep.iotcc.telkomsel.com/#!dashboard

# CMP credentials are placeholders only and never real values here
CMP_USERNAME=your_username
CMP_PASSWORD=your_password

# IMAP Configuration
IMAP_HOST=mail.gmf-aeroasia.co.id
IMAP_PORT=993
IMAP_USERNAME=your_imap_username
IMAP_PASSWORD=your_imap_password
# IMAP TLS mode is imaps or starttls
IMAP_TLS_MODE=imaps
# TLS certificate verification is mandatory and must not be disabled
IMAP_VERIFY_TLS=true
IMAP_MAILBOX=INBOX

# OTP Settings
# OTP subject must exactly match the enforced subject
OTP_SUBJECT=CMP - YOUR TOKEN
OTP_POLL_INTERVAL_SECONDS=2
OTP_TIMEOUT_SECONDS=120
OTP_CLOCK_SKEW_TOLERANCE_SECONDS=120

# Runtime & Browser Settings
RUN_START_TIMEZONE=Asia/Jakarta
BROWSER_TIMEOUT_MS=30000
NAVIGATION_TIMEOUT_MS=60000
OTP_FORM_TIMEOUT_MS=30000
REFRESH_INTERVAL_SECONDS=60
RECOVERY_RETRY_LIMIT=3
RECOVERY_BACKOFF_SECONDS=5
# Runtime is headed by default; set HEADLESS=true for headless operation.
HEADLESS=true
# Optional: use the installed Firefox executable instead of Playwright's bundled browser.
# FIREFOX_EXECUTABLE_PATH=C:\\Program Files\\Mozilla Firefox\\firefox.exe

# Logging
LOG_LEVEL=INFO
